# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- GitHub -----------------------------------------------------------------
# Fine-grained personal access token with, on the target repositories:
#   Pull requests: Read and write
#   Contents:      Read-only        (to read .reviewbot.yml)
# Create at: Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=

# Shared secret you set when creating the webhook. Without it the endpoint
# accepts requests from anyone — see the security note in the README.
GITHUB_WEBHOOK_SECRET=

# --- Anthropic --------------------------------------------------------------
# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Model ------------------------------------------------------------------
# claude-sonnet-4-5 balances quality and cost. Haiku is roughly 5x cheaper and
# noticeably blunter; Opus is better at subtle logic bugs and costs more.
MODEL=claude-sonnet-4-5
MAX_TOKENS_PER_REQUEST=4096
CHUNK_BUDGET_TOKENS=12000

# --- Limits -----------------------------------------------------------------
MAX_COMMENTS_HARD_LIMIT=25
DEFAULT_MAX_COMMENTS=10
DEFAULT_SEVERITY_THRESHOLD=minor
MAX_FILE_LINES=1500
MAX_CONCURRENT_LLM_CALLS=4

# --- Behaviour --------------------------------------------------------------
# true = analyse and log the review, never post it. Use this first.
DRY_RUN=false
LOG_LEVEL=INFO
